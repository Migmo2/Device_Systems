"""
Ejemplo de variables de entorno para la aplicación
Copia este archivo a .env y ajusta los valores según tus necesidades
"""

# FastAPI Configuration
APP_NAME=device_systems
API_VERSION=1.0
DEBUG=True

# Server Configuration
HOST=127.0.0.1
PORT=8000
RELOAD=True

# Database (para futuro uso)
# DATABASE_URL=postgresql://user:password@localhost/device_systems

# Security
SECRET_KEY=change-this-development-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
